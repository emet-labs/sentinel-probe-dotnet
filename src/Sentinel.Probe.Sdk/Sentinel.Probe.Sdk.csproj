<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Sentinel.Probe.Sdk: the .NET Probe SDK, mirroring sdk/go module-for-module.

      Hand-written Connect unary over HttpClient (SentinelTransport.cs) — there is no
      connectrpc/csharp, so the unary Decide RPC is written directly on System.Net.Http with
      Content-Type: application/proto, exactly as the Go reference's connectrpc.com/connect does
      over net/http. Connect's unary application/proto framing is a raw protobuf body for a
      successful response and a Connect error envelope for a failure, both of which
      SentinelTransport handles.
    -->
    <RootNamespace>Sentinel.Probe.Sdk</RootNamespace>
    <AssemblyName>Sentinel.Probe.Sdk</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>Sentinel.Probe.Sdk</PackageId>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Google.Protobuf pinned to 3.33.4 to match the BSR remote plugin
      buf.build/protocolbuffers/csharp:v33.4 (S3 fix: exact versions, no floating ranges). The
      hand-written messages in gen/ use CodedOutputStream/CodedInputStream for binary wire
      compatibility, which are stable across the 3.x runtime.
    -->
    <PackageReference Include="Google.Protobuf" Version="3.33.4" />
    <!--
      OpenTelemetry 1.17.0 provides BaseProcessor<Activity> (ProbeSpanProcessor),
      TracerProvider, Sdk and ResourceBuilder. .NET OTel is built on System.Diagnostics.Activity,
      the runtime's native tracing API, so no separate tracer dependency is needed.
    -->
    <PackageReference Include="OpenTelemetry" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Api" Version="1.17.0" />
  </ItemGroup>

  <!-- Tests reach internal helpers (FilterStore.EqualEpoch, SpecMatch). -->
  <ItemGroup>
    <InternalsVisibleTo Include="Sentinel.Probe.Sdk.Tests" />
  </ItemGroup>

  <!--
    S2 fix: exclude generated-style proto code from TreatWarningsAsErrors by lowering its
    warning level to 0. The gen/ tree mirrors what protoc-gen-csharp would emit and is
    regenerated from proto/ by tools/generate-dotnet-sdk.sh; hand-checked-in here until the buf
    pipeline runs in CI (see gen/README.md).
  -->
  <ItemGroup>
    <Compile Update="gen/**/*.cs">
      <WarningLevel>0</WarningLevel>
    </Compile>
  </ItemGroup>

</Project>
